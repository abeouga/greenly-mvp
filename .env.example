# Copy this file to .env and set the password locally.
GREENLY_DB_USER=greenly_dev
GREENLY_DB_PASSWORD=
# Optional. Existing jdbc:mysql:// URLs without query parameters are also accepted.
# GREENLY_DB_URL=mysql://127.0.0.1:3306/greenly
# E2E uses only GREENLY_E2E_DB_* environment variables or the ignored .env.e2e file.
# GREENLY_E2E_DB_USER=greenly_e2e
# GREENLY_E2E_DB_PASSWORD=
# GREENLY_E2E_DB_URL=mysql://127.0.0.1:3306/greenly_e2e
